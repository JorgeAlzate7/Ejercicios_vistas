<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ejercicios Prácticos Android"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnEx1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejercicio 1" />

        <Button
            android:id="@+id/btnEx2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejercicio 2" />

        <Button
            android:id="@+id/btnEx3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejercicio 3" />

        <Button
            android:id="@+id/btnEx4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejercicio 4" />

        <Button
            android:id="@+id/btnEx5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejercicio 5" />

        <Button
            android:id="@+id/btnEx6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejercicio 6" />

        <Button
            android:id="@+id/btnEx7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejercicio 7" />

        <Button
            android:id="@+id/btnEx8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejercicio 8" />

    </LinearLayout>
</ScrollView>